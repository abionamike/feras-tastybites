# Copy to .env.local and fill in. Everything is optional except ADMIN_PASSWORD
# (needed to open /admin).

# Password for the kitchen dashboard at /admin
ADMIN_PASSWORD=

# Public URL of the live site, used for the sitemap and payment redirects
SITE_URL=https://your-domain.com

# --- Card payments (Stripe Checkout) ---
# When set, "Credit / debit card" appears at checkout.
STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook pointing at /api/stripe/webhook
# (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# --- Interac e-Transfer ---
# Shown to customers on their order page
NEXT_PUBLIC_ETRANSFER_EMAIL=

# --- Email notifications (Resend) ---
RESEND_API_KEY=
# Where new orders and enquiries are sent
ORDER_NOTIFY_EMAIL=
# A sender on a domain verified in Resend, e.g. "Feras Tasty Bites <orders@your-domain.com>"
EMAIL_FROM=

# Folder for the JSON order database (defaults to ./.data)
DATA_DIR=
